NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Legacy fallback also supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Used by the trusted bootstrap scripts to grant the protected admin claim. ADMIN_EMAIL also works.
SUPABASE_ADMIN_EMAIL=your-existing-admin@example.com
# Only needed when the bootstrap script must create that account. ADMIN_PASSWORD also works.
# SUPABASE_ADMIN_PASSWORD=use-a-long-unique-secret
NEXT_PUBLIC_SITE_URL=https://prajjwolbhandari.com
